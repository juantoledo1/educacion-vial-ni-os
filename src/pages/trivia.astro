---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Trivia de Seguridad Vial">
  <div class="trivia-wrapper">
    <h2 class="text-center mb-4">Trivia de Seguridad Vial</h2>
    <p class="lead text-center">Responde las preguntas y aprende sobre cómo estar seguro en las calles.</p>
    
    <div id="trivia-container" class="trivia-box">
      <h3 id="pregunta" class="text-primary"></h3>
      <div id="opciones" class="mt-3">
        <!-- Aquí se mostrarán las opciones -->
      </div>
    </div>
  </div>

  <!-- Script de trivia -->
  <script type="text/javascript">
    const todasLasPreguntas = [
    { pregunta: "¿Qué debes hacer antes de cruzar la calle?", opciones: ["Mirar a ambos lados", "Correr rápido", "Usar el celular"], correcta: 0, explicacion: "Antes de cruzar la calle, siempre debes mirar a ambos lados para asegurarte de que no vengan vehículos." },
  { pregunta: "¿Qué significa una luz roja en el semáforo?", opciones: ["Avanzar", "Detenerse", "Acelerar"], correcta: 1, explicacion: "La luz roja significa que debes detenerte. Espera a que la luz cambie a verde antes de continuar." },
  { pregunta: "¿Qué debes hacer si vas en bicicleta y ves un semáforo en amarillo?", opciones: ["Acelerar", "Detenerse", "Seguir igual"], correcta: 1, explicacion: "Debes detenerte cuando el semáforo está en amarillo, ya que pronto se encenderá la luz roja." },
  { pregunta: "¿Por dónde debes caminar si no hay vereda?", opciones: ["Por el medio de la calle", "Por la derecha de la calle", "Por la izquierda, de frente a los vehículos"], correcta: 2, explicacion: "Camina por la izquierda, de frente al tránsito, para poder ver los vehículos que se aproximan." },
  { pregunta: "¿Qué significa la señal de 'Pare'?", opciones: ["Reducir la velocidad", "Detenerse por completo", "Seguir con precaución"], correcta: 1, explicacion: "La señal de 'Pare' indica que debes detenerte completamente y ceder el paso." },
  { pregunta: "¿Qué debes hacer si un vehículo está dando marcha atrás?", opciones: ["Esperar a que termine", "Caminar detrás de él", "Tocar la bocina"], correcta: 0, explicacion: "Es más seguro esperar a que el vehículo termine de retroceder antes de cruzar." },
  { pregunta: "¿Cuál es la mejor forma de cruzar una calle sin semáforo?", opciones: ["Cruzando en diagonal", "Cruzando en línea recta", "Cruzando corriendo"], correcta: 1, explicacion: "Cruza en línea recta para reducir el tiempo que estás en la calle." },
  { pregunta: "¿Qué debes hacer si un semáforo está en amarillo intermitente?", opciones: ["Detenerte", "Proceder con precaución", "Acelerar"], correcta: 1, explicacion: "El amarillo intermitente indica precaución; procede con cuidado." },
  { pregunta: "¿Por qué es importante usar el cinturón de seguridad?", opciones: ["Te protege en caso de accidente", "Evita que el auto se apague", "Es una norma de tránsito"], correcta: 0, explicacion: "El cinturón de seguridad te protege y puede salvar tu vida en caso de accidente." },
  { pregunta: "¿Qué significa una luz verde en el semáforo?", opciones: ["Detenerse", "Avanzar con precaución", "Avanzar"], correcta: 1, explicacion: "La luz verde indica que puedes avanzar, pero siempre con precaución." },
  { pregunta: "¿Qué hacer si un peatón está cruzando por una esquina?", opciones: ["Esperar a que cruce", "Tocar la bocina", "Seguir conduciendo"], correcta: 0, explicacion: "Es importante esperar a que el peatón termine de cruzar." },
  { pregunta: "¿Qué debes hacer si escuchas una sirena de emergencia?", opciones: ["Detenerte de inmediato", "Ceder el paso y detenerte", "Seguir conduciendo"], correcta: 1, explicacion: "Debes ceder el paso a los vehículos de emergencia y detenerte si es necesario." },
  { pregunta: "¿Por qué es peligroso usar el celular mientras caminas?", opciones: ["Porque gasta batería", "Porque distrae y reduce la atención", "Porque te hace más lento"], correcta: 1, explicacion: "El celular te distrae y disminuye tu atención, aumentando el riesgo de accidentes." },
  { pregunta: "¿Qué indica una línea amarilla continua en la carretera?", opciones: ["Puedes adelantar", "No debes adelantar", "Debes detenerte"], correcta: 1, explicacion: "Una línea amarilla continua indica que no es seguro adelantar." },
  { pregunta: "¿Qué significa la señal de 'Ceda el paso'?", opciones: ["Acelerar", "Detenerte", "Reducir la velocidad y ceder el paso"], correcta: 2, explicacion: "La señal indica que debes reducir la velocidad y ceder el paso a otros." },
  { pregunta: "¿Cuál es la distancia mínima que debes mantener con el vehículo de adelante?", opciones: ["La que te permite ver la matrícula", "La que te permite frenar a tiempo", "La que te permite acelerar rápido"], correcta: 1, explicacion: "Mantén una distancia que te permita frenar a tiempo en caso de emergencia." },
  { pregunta: "¿Qué debes hacer si ves una señal de 'No estacionar'?", opciones: ["Estacionar rápido", "Buscar otro lugar para estacionar", "Esperar dentro del vehículo"], correcta: 1, explicacion: "Debes buscar otro lugar permitido para estacionar cuando veas 'No estacionar'." },
  { pregunta: "¿Qué hacer si un semáforo peatonal está en rojo?", opciones: ["Cruzar rápidamente", "Esperar a que cambie a verde", "Correr por la esquina"], correcta: 1, explicacion: "Es vital esperar a que el semáforo peatonal cambie a verde." },
  { pregunta: "Si un ciclista está en tu carril, ¿qué debes hacer?", opciones: ["Tocar la bocina", "Acelerar", "Reducir la velocidad y adelantar con precaución"], correcta: 2, explicacion: "Debes reducir la velocidad y adelantar al ciclista con precaución, dejando suficiente espacio." },
  { pregunta: "¿Qué significa la señal de 'Desvío'?", opciones: ["Cambio de carril", "Cierre total de la carretera", "Cambio temporal de la ruta"], correcta: 2, explicacion: "La señal de 'Desvío' indica que debes seguir una ruta alternativa temporalmente." },
  { pregunta: "¿Qué debes hacer antes de cruzar la calle al salir de una tienda?", opciones: ["Correr a cruzar", "Mirar a ambos lados", "Salir sin mirar"], correcta: 1, explicacion: "Siempre mira a ambos lados antes de cruzar, incluso al salir de una tienda." },
  { pregunta: "Si un cruce peatonal tiene luz roja, ¿qué debes hacer?", opciones: ["Esperar a que cambie a verde", "Cruzar rápido", "Correr"], correcta: 0, explicacion: "Debes esperar a que la luz cambie a verde para cruzar de forma segura." },
  { pregunta: "¿Qué hacer si un vehículo se detiene cerca de ti en la acera?", opciones: ["Ignorar", "Alejarte con precaución", "Acercarte al vehículo"], correcta: 1, explicacion: "Aléjate con precaución si un vehículo se detiene cerca de ti en la acera." },
  { pregunta: "¿Por qué es importante usar cascos al andar en bicicleta?", opciones: ["Por moda", "Para proteger la cabeza", "Porque la ley lo exige"], correcta: 1, explicacion: "El casco protege tu cabeza en caso de caída o accidente." },
  { pregunta: "Si un peatón mayor cruza la calle, ¿qué debes hacer?", opciones: ["Ofrecer ayuda y esperar", "Acelerar", "Ignorarlo"], correcta: 0, explicacion: "Es respetuoso y seguro esperar y ofrecer ayuda si es necesario." },
  { pregunta: "¿Qué indica la señal 'Ceda el paso' en un cruce sin semáforo?", opciones: ["Detenerse si es necesario", "Acelerar", "No hacer nada"], correcta: 0, explicacion: "Debes detenerte si es necesario para permitir el paso." },
  { pregunta: "¿Por qué es importante respetar los límites de velocidad?", opciones: ["Para llegar más rápido", "Para evitar accidentes y multas", "No es importante"], correcta: 1, explicacion: "Respetar los límites de velocidad ayuda a prevenir accidentes y sanciones." },
  { pregunta: "¿Qué debes hacer si un auto en movimiento se detiene bruscamente frente a ti?", opciones: ["Frenar lentamente", "Mantener la calma y frenar de inmediato", "Ignorar y seguir conduciendo"], correcta: 1, explicacion: "Frena de inmediato para evitar una colisión." },
  { pregunta: "¿Qué significa un semáforo intermitente en amarillo?", opciones: ["Detenerse", "Proceder con precaución", "Acelerar"], correcta: 1, explicacion: "Significa que debes proceder con precaución, ya que la luz roja pronto se encenderá." },
  { pregunta: "¿Por qué no se deben usar dispositivos electrónicos mientras se camina?", opciones: ["Porque distraen", "Porque son costosos", "Porque dañan la vista"], correcta: 0, explicacion: "Distraen y reducen tu atención, aumentando el riesgo de accidentes." },
  { pregunta: "Si estás en una acera estrecha y un auto se detiene para dejar pasar a un peatón, ¿qué debes hacer?", opciones: ["Quedarte quieto", "Moverte hacia el centro de la acera", "Salir corriendo"], correcta: 0, explicacion: "Permanece en tu lugar para no obstaculizar el paso." },
  { pregunta: "¿Qué debes hacer si ves un vehículo realizando maniobras peligrosas?", opciones: ["Ignorar", "Alejarte con precaución", "Participar en la maniobra"], correcta: 1, explicacion: "Es mejor alejarte con precaución para evitar riesgos." },
  { pregunta: "¿Qué indica la señal de 'Stop' en una intersección?", opciones: ["Reducir la velocidad", "Detenerse completamente", "Continuar sin parar"], correcta: 1, explicacion: "La señal 'Stop' te exige detenerte completamente antes de avanzar." },
  { pregunta: "¿Qué debes hacer si ves un cruce peatonal sin semáforo y muchos niños cruzando?", opciones: ["Acelerar", "Detenerte y esperar", "Ignorar y cruzar rápidamente"], correcta: 1, explicacion: "Detente y espera a que todos crucen de forma segura." },
  { pregunta: "¿Qué debes hacer si un auto señala que va a girar y un peatón se acerca?", opciones: ["Ignorar", "Reducir la velocidad y detenerte", "Acelerar"], correcta: 1, explicacion: "Reduce la velocidad y detente para evitar peligro." },
  { pregunta: "¿Cómo debes reaccionar si escuchas una alerta de tráfico en la radio mientras cruzas?", opciones: ["Continuar sin prestar atención", "Detenerte y prestar atención", "Acelerar para evitar la zona"], correcta: 1, explicacion: "Detente y presta atención a la alerta para actuar con seguridad." },
  { pregunta: "¿Qué precaución debes tomar al subir o bajar de un autobús?", opciones: ["Subir rápido", "Esperar a que se detenga completamente", "Ignorar las señales"], correcta: 1, explicacion: "Es vital esperar a que el autobús se detenga completamente antes de subir o bajar." },
  { pregunta: "¿Por qué es importante esperar en las paradas de autobús?", opciones: ["Para ahorrar tiempo", "Para evitar accidentes", "No es importante"], correcta: 1, explicacion: "Esperar en las paradas de autobús es una medida de seguridad para evitar accidentes." },
  { pregunta: "Si ves a un adulto usando el teléfono mientras camina, ¿qué debes hacer?", opciones: ["Ayudarlo a prestar atención", "Ignorarlo", "Seguir su ejemplo"], correcta: 0, explicacion: "Es un buen gesto ayudar a que preste atención a su entorno." },
  { pregunta: "¿Qué medida de seguridad debes seguir al caminar cerca de zonas escolares?", opciones: ["Caminar rápido", "Mantenerse alerta y caminar con precaución", "Correr siempre"], correcta: 1, explicacion: "Debes estar alerta y caminar con precaución cerca de zonas escolares." },
    ];

    let preguntas = [];
    let preguntaActual = 0;
    let puntaje = 0;

    function seleccionarPreguntas() {
      preguntas = [...todasLasPreguntas];
      mezclarArray(preguntas);
      preguntas = preguntas.slice(0, 10); // Seleccionar 10 preguntas
    }

    function mezclarArray(array) {
      for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
      }
    }

    function manejarRespuesta(opcionIndex) {
      const esCorrecta = opcionIndex === preguntas[preguntaActual].correcta;

      const toastMessage = esCorrecta
        ? `¡Correcto! ${preguntas[preguntaActual].explicacion}`
        : `Incorrecto. ${preguntas[preguntaActual].explicacion}`;

      mostrarToast(toastMessage, esCorrecta ? 'bg-success' : 'bg-danger');

      if (esCorrecta) {
        puntaje++;
      }

      preguntaActual++;
      if (preguntaActual < preguntas.length) {
        mostrarPregunta();
      } else {
        mostrarResultados();
      }
    }

    function mostrarPregunta() {
  const pregunta = preguntas[preguntaActual];
  document.getElementById('pregunta').innerText = pregunta.pregunta;
  const opcionesDiv = document.getElementById('opciones');
  opcionesDiv.innerHTML = '';
  pregunta.opciones.forEach((opcion, index) => {
    const button = document.createElement('button');
    button.className = 'btn btn-primary d-block w-100 my-2';  // Aquí se agregan las clases d-block y w-100
    button.innerText = opcion;
    button.onclick = () => manejarRespuesta(index);
    opcionesDiv.appendChild(button);
  });
}

    function mostrarResultados() {
      document.getElementById('pregunta').innerText = `Juego terminado. Tu puntaje es: ${puntaje} de 10`;
      document.getElementById('opciones').innerHTML = `<button class="btn btn-warning" onclick="reiniciarJuego()">Reiniciar</button>`;
    }

    function reiniciarJuego() {
      puntaje = 0;
      preguntaActual = 0;
      seleccionarPreguntas();
      mostrarPregunta();
    }

    function mostrarToast(mensaje, estilo) {
      const toastDiv = document.createElement('div');
      toastDiv.className = `toast ${estilo} text-white`;
      toastDiv.style.position = 'fixed';
      toastDiv.style.bottom = '10px';
      toastDiv.style.right = '10px';
      toastDiv.style.zIndex = 1000;
      toastDiv.innerHTML = `
        <div class="toast-body">
          ${mensaje}
        </div>
      `;
      document.body.appendChild(toastDiv);

      const toast = new bootstrap.Toast(toastDiv);
      toast.show();

      setTimeout(() => {
        toastDiv.remove();
      }, 5000);
    }

    // Inicializar el juego
    seleccionarPreguntas();
    mostrarPregunta();
  </script>

  <style>
    .trivia-wrapper {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }

    .trivia-box {
      background-color: #99f1f4;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .btn-block {
      width: 100%;
    }
  </style>
</Layout>
