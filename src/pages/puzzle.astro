---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Juego de Seguridad Vial">
  <h2 class="text-center my-4 text-primary">Asocia los Elementos de Seguridad Vial</h2>
  <p class="text-center text-muted mb-5">
    Arrastra los elementos de seguridad vial y colócalos en la categoría correcta.
  </p>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="d-flex flex-column align-items-center">
          <div class="mb-4 d-flex flex-wrap justify-content-center">
            <div id="category1" class="border border-3 border-success rounded p-4 mb-3 position-relative d-flex flex-column align-items-center justify-content-center shadow-lg category-box" style="background-color: #4dc63b;">
              <p class="text-center m-0 fw-bold">Señales de Tráfico</p>
            </div>
            <div id="category2" class="border border-3 border-warning rounded p-4 mb-3 position-relative d-flex flex-column align-items-center justify-content-center shadow-lg category-box" style="background-color: #efdd8c;">
              <p class="text-center m-0 fw-bold">Protección Personal</p>
            </div>
            <div id="category3" class="border border-3 border-danger rounded p-4 mb-3 position-relative d-flex flex-column align-items-center justify-content-center shadow-lg category-box" style="background-color: #df754b;">
              <p class="text-center m-0 fw-bold">Vehículos Seguros</p>
            </div>
            <div id="category4" class="border border-3 border-info rounded p-4 mb-3 position-relative d-flex flex-column align-items-center justify-content-center shadow-lg category-box" style="background-color: #8cb8e3;">
              <p class="text-center m-0 fw-bold">Normas Peatonales</p>
            </div>
          </div>

          <div id="draggableItems" class="d-flex gap-3 flex-wrap justify-content-center"></div>

          <button id="resetButton" class="btn btn-success mt-4">Volver a Jugar</button>
        </div>
      </div>
    </div>
  </div>

  <div id="toastContainer" class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100;"></div>

  <div id="finalToast" class="toast d-none final-toast" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="toast-header text-center">
      <strong class="me-auto">¡Felicidades!</strong>
      <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
    <div class="toast-body">
      ¡Has completado el juego! ¡Eres un campeón! 🏆
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const categories = document.querySelectorAll('.category-box');
      const draggableItemsContainer = document.getElementById('draggableItems');
      const resetButton = document.getElementById('resetButton');
      const toastContainer = document.getElementById('toastContainer');
      const finalToastEl = document.getElementById('finalToast');

      // Variable para almacenar el contenedor resaltado actualmente (touch)
      let currentHighlightCategory = null;

      // Datos del juego
      const itemsData = [
        { id: 'item1', image: '/images/senales/traffic-light.jpg', label: 'Semáforo', category: 'category1' },
        { id: 'item2', image: '/images/senales/helmet.jpg', label: 'Casco', category: 'category2' },
        { id: 'item3', image: '/images/senales/stop-sign.jpg', label: 'Señal de Stop', category: 'category1' },
        { id: 'item4', image: '/images/senales/car.jpg', label: 'Coche', category: 'category3' },
        { id: 'item5', image: '/images/senales/bicycle.jpg', label: 'Bicicleta', category: 'category3' },
        { id: 'item6', image: '/images/senales/pedestrian-crossing.jpg', label: 'Cruce peatonal', category: 'category4' },
        { id: 'item7', image: '/images/senales/speed-limit-50.jpg', label: 'Límite de velocidad', category: 'category1' },
        { id: 'item8', image: '/images/senales/no-entry.jpg', label: 'Prohibido el paso', category: 'category1' },
        { id: 'item9', image: '/images/senales/bus.jpg', label: 'Autobús', category: 'category3' },
        { id: 'item10', image: '/images/senales/motorcycle.jpg', label: 'Moto', category: 'category3' },
      ];

      let correctItems = 0;
      let totalItems = itemsData.length;

      function mostrarToast(mensaje, tipo = 'info', grande = false) {
        const toast = document.createElement('div');
        toast.classList.add('toast', 'fade', 'show', `bg-${tipo}`);
        if (grande) toast.classList.add('toast-grande');
        toast.innerHTML = `<div class="toast-body">${mensaje}</div>`;

        // Si el ancho de la ventana es menor o igual a 768px, posiciona el toast en la parte superior centrado
        if (window.innerWidth <= 768) {
          toast.style.position = 'fixed';
          toast.style.top = '10px';
          toast.style.left = '50%';
          toast.style.transform = 'translateX(-50%)';
          // Quitar bottom/right para evitar conflictos
          toast.style.bottom = '';
          toast.style.right = '';
        } else {
          // En pantallas grandes, lo dejamos en la posición actual (abajo centrado)
          toast.style.position = 'fixed';
          toast.style.bottom = '20px';
          toast.style.left = '50%';
          toast.style.transform = 'translateX(-50%)';
        }

        toast.style.zIndex = 1000;
        toastContainer.appendChild(toast);

        setTimeout(() => toast.remove(), grande ? 5000 : 3000);
      }


      function finalToast() {
        finalToastEl.classList.remove('d-none');
        finalToastEl.classList.add('show');
        setTimeout(() => {
          finalToastEl.classList.remove('show');
          finalToastEl.classList.add('d-none');
        }, 5000);
      }

      // Eventos touch
      let draggedElement = null;
      let touchStartX = 0;
      let touchStartY = 0;

      const addTouchEventListeners = () => {
        document.querySelectorAll('.draggable-item').forEach(item => {
          item.addEventListener('touchstart', handleTouchStart, { passive: false });
          item.addEventListener('touchmove', handleTouchMove, { passive: false });
          item.addEventListener('touchend', handleTouchEnd);
          item.addEventListener('touchcancel', handleTouchEnd);
        });
      };

      const handleTouchStart = (e) => {
        draggedElement = e.target.closest('.draggable-item');
        if (!draggedElement) return;
        const touch = e.touches[0];
        touchStartX = touch.clientX - draggedElement.getBoundingClientRect().left;
        touchStartY = touch.clientY - draggedElement.getBoundingClientRect().top;
        draggedElement.style.position = 'absolute';
        draggedElement.style.zIndex = '1000';
        updateElementPosition(touch);
      };

      const handleTouchMove = (e) => {
        if (!draggedElement) return;
        e.preventDefault();
        const touch = e.touches[0];
        updateElementPosition(touch);
        // --- Aquí se amplía la zona de detección con un offset vertical ---
        let currentCategory = document.elementFromPoint(touch.clientX, touch.clientY + 35)?.closest('.category-box');
        if (currentCategory !== currentHighlightCategory) {
          if (currentHighlightCategory) {
            currentHighlightCategory.classList.remove('category-highlight');
          }
          if (currentCategory) {
            currentCategory.classList.add('category-highlight');
          }
          currentHighlightCategory = currentCategory;
        }
      };

      const handleTouchEnd = (e) => {
        if (!draggedElement) return;
        const touch = e.changedTouches[0];
        let category = document.elementFromPoint(touch.clientX, touch.clientY)?.closest('.category-box');
        if (!category) {
          category = document.elementFromPoint(touch.clientX, touch.clientY + 20)?.closest('.category-box');
        }
        categories.forEach(cat => cat.classList.remove('category-highlight'));
        currentHighlightCategory = null;
        if (category) {
          checkTouchAnswer(category, draggedElement);
        }
        resetElementPosition();
      };

      const updateElementPosition = (touch) => {
        const elementWidth = draggedElement.offsetWidth;
        const elementHeight = draggedElement.offsetHeight;
        const scrollY = window.scrollY;
        draggedElement.style.left = `${touch.clientX - touchStartX - (elementWidth / 2.5)}px`;
        draggedElement.style.top = `${touch.clientY - touchStartY - (elementHeight / 2.5) + scrollY}px`;
      };

      const resetElementPosition = () => {
        if (draggedElement) {
          draggedElement.style.position = 'static';
          draggedElement.style.zIndex = 'auto';
          draggedElement = null;
        }
      };

      const checkTouchAnswer = (category, element) => {
        const correctCategory = itemsData.find(item => item.id === element.id)?.category;
        if (correctCategory === category.id) {
          element.remove();
          correctItems++;
          mostrarToast('¡Correcto! Elemento colocado. 🎉', 'success');
          if (correctItems === totalItems) {
            setTimeout(finalToast, 500);
          }
        } else {
          element.classList.add('shake');
          setTimeout(() => element.classList.remove('shake'), 500);
          mostrarToast('Elemento incorrecto. ¡Inténtalo de nuevo! ❌', 'danger');
        }
      };

      function addDesktopDragListeners() {
        document.querySelectorAll('.draggable-item').forEach(item => {
          item.addEventListener('dragstart', (e) => {
            e.dataTransfer.setData('text/plain', item.id);
            item.classList.add('opacity-50');
          });
          item.addEventListener('dragend', () => {
            item.classList.remove('opacity-50');
          });
        });
        categories.forEach(category => {
          category.addEventListener('dragenter', () => {
            category.classList.add('category-highlight');
          });
          category.addEventListener('dragleave', () => {
            category.classList.remove('category-highlight');
          });
        });
      }

      function initializeGame() {
        correctItems = 0;
        const shuffledItems = [...itemsData].sort(() => Math.random() - 0.5);
        draggableItemsContainer.innerHTML = '';

        shuffledItems.forEach((item) => {
          const div = document.createElement('div');
          div.id = item.id;
          div.className = 'draggable-item rounded shadow-sm text-center';
          div.draggable = true;
          div.style.width = '80px';
          div.style.cursor = 'grab';
          div.innerHTML = `
            <img src="${item.image}" alt="${item.label}" onerror="this.src='/assets/images/placeholder.jpg'; this.alt='Imagen no disponible'" style="width: 100%; height: 80px; object-fit: cover;" />
            <p class="small text-muted mt-1">${item.label}</p>
          `;
          draggableItemsContainer.appendChild(div);
        });

        addDesktopDragListeners();
        mostrarToast('¡El juego ha comenzado! Arrastra los elementos a la categoría correcta.', 'info');
        addTouchEventListeners();
      }

      initializeGame();

      categories.forEach((category) => {
        category.addEventListener('dragover', (e) => e.preventDefault());
        category.addEventListener('drop', (e) => {
          e.preventDefault();
          const itemId = e.dataTransfer.getData('text/plain');
          const item = document.getElementById(itemId);
          const correctCategory = itemsData.find(data => data.id === itemId)?.category;
          if (correctCategory === category.id) {
            if (item) item.remove();
            correctItems++;
            mostrarToast('¡Correcto! Elemento colocado. 🎉', 'success');
            if (correctItems === totalItems) setTimeout(finalToast, 500);
          } else {
            mostrarToast('Elemento incorrecto. ¡Inténtalo de nuevo! ❌', 'danger');
          }
        });
      });

      resetButton.addEventListener('click', () => {
        initializeGame();
      });
    });
  </script>

  <style>
    /* Efecto de highlight para contenedores */
    .category-highlight {
      box-shadow: 0 0 15px 6px rgba(0, 123, 255, 0.7);
      transform: scale(1.06);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    /* Contenedores principales */
    .game-container {
      max-width: 100%;
      overflow: hidden;
    }
    /* Scroll horizontal */
    .categories-scroll,
    .items-scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 10px;
      margin: 1rem 0;
    }
    /* Categorías */
    .category-box {
      width: 200px;
      height: 150px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      padding: 1rem;
      background: #f8f9fa;
    }
    .category-title {
      font-weight: 700;
      margin: 0;
      text-align: center;
      font-size: 1rem;
    }
    /* Elementos arrastrables */
    .draggable-item {
      cursor: grab;
      width: 90px;
      height: 100px;
      border: 2px solid #ddd;
      border-radius: 8px;
      padding: 0.2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: white;
      flex-shrink: 0;
      touch-action: none;
    }
    .draggable-item img {
      width: 100%;
      height: 60px;
      object-fit: contain;
      margin-bottom: 0.3rem;
      display: block;
    }
    .draggable-item p {
      font-size: 0.75rem;
      text-align: center;
      margin: 0;
      color: #6c757d;
      line-height: 1.2;
    }
    /* Toasts */
    .toast {
      min-width: 200px;
      max-width: 300px;
      z-index: 1050;
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      padding: 1rem 2rem;
      border-radius: 8px;
      color: white;
      font-size: 0.9rem;
    }
    .toast .toast-body {
      font-size: 1rem;
      color: #fff;
    }
    .toast.success { background: #28a745 !important; }
    .toast.info { background: #17a2b8 !important; }
    .toast.danger { background: #dc3545 !important; }
    .toast.warning { background: #ffc107 !important; }
    .toast-grande .toast-body {
      font-size: 1.5rem;
    }
    .final-toast {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 1100;
      min-width: 300px;
      text-align: center;
      background-color: #28a745 !important;
      color: #fff !important;
      padding: 1rem;
      border-radius: 0.5rem;
      font-size: 1.5rem;
    }
    /* Animaciones */
    .shake {
      animation: shake 0.5s;
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-8px); }
      75% { transform: translateX(8px); }
    }
    /* Responsividad para móviles */
    @media (max-width: 768px) {
      .draggable-item {
        width: 70px;
        height: 80px;
      }
      .draggable-item img {
        height: 50px;
      }
      .category-box {
        width: 150px;
        height: 120px;
        padding: 1rem;
      }
      .category-box p {
        font-size: 0.9rem;
      }
    }
    @media (max-width: 480px) {
      .draggable-item {
        width: 60px;
        height: 70px;
      }
      .draggable-item img {
        height: 40px;
      }
      .category-box {
        width: 130px;
        height: 100px;
        padding: 0.6rem;
      }
      .category-box p {
        font-size: 0.9rem;
      }
    }
  </style>
</Layout>
